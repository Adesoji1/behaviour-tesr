# Copy to `.env` and fill in. docker-compose and local runs load this automatically.

# ---- production Postgres (READ ONLY: the transactions source) ----
# Only sync_manager.py reads this. Point it at a READ REPLICA if one exists —
# that shields the primary completely (ingestionstratimprove.md §4).
PROD_PG_HOST=your-postgres-host
PROD_PG_PORT=25061
PROD_PG_USER=your-pg-user
PROD_PG_PASSWORD=your-pg-password
PROD_PG_DB=adhere
PROD_PG_SSLMODE=require

# ---- PROFILE STORE: PostgreSQL (where profiles / rules / cache / events live) ----
# In docker compose the host is the `db` service; STORE_PG_PASSWORD is required
# (compose refuses to start without it) and is the password on the database itself.
STORE_PG_HOST=db
STORE_PG_PORT=5432
# Port published on YOUR machine (5433 avoids clashing with a local postgres).
STORE_PG_HOST_PORT=5433
STORE_PG_USER=behaviour
STORE_PG_PASSWORD=change-me-strong-password
STORE_PG_DB=behaviour
STORE_PG_SSLMODE=prefer

# ---- learning / trust tuning (all optional; sensible defaults in config.py) ----
BP_LOOKBACK_MONTHS=3
BP_DECAY_HALF_LIFE=90
BP_MIN_TENURE_DAYS=90
# "Practical rules" §1: ">= 100 transactions" (§2 sanctions 50-500;
# 100 satisfies BOTH). Was 50, which met only §2.
BP_MIN_TXNS=100
BP_CONFIDENCE_TRUST=60
# §1: "No confirmed fraud cases" — max confirmed-fraud txns and still trusted. 0 = the PDF's rule.
BP_ELIGIBLE_MAX_FRAUD_TXNS=0
BP_RETRAIN_MIN_NEW_TXNS=100
BP_RETRAIN_MAX_AGE_DAYS=30
BP_DRIFT_SIGNAL_THRESHOLD=5
BP_LIVE_VELOCITY=1

# ---- production protection ----
# Safety switch. 1 = allow live reads from prod (sync_manager + live velocity).
# 0 = STOP every live pull: the sync refuses to run, extracts refuse to run, and
# the service serves entirely from the local cache. Every pull / blocked attempt
# is logged to stdout.
BP_ALLOW_PROD_PULL=1

# ---- ingestion (sync_manager.py) — the dials the DB engineer can turn ----
# The sync is the ONLY process that reads production. It pages with a keyset
# cursor in bounded chunks, caps each run, and sleeps between chunks.
BP_SYNC_CHUNK_SIZE=5000            # rows per bounded query
BP_SYNC_MAX_ROWS=50000             # hard cap per run (0 = uncapped)
BP_SYNC_SLEEP_SECONDS=0.2          # throttle between chunks — raise to be gentler
BP_SYNC_STATEMENT_TIMEOUT_MS=30000 # server kills any runaway query
BP_SYNC_REFRESH_DAYS=2             # re-pull recent days so status flips are caught
BP_SYNC_PRUNE=1                    # drop cached rows older than the learning window
# --- scheduled ingestion (production): the sync runs automatically on this
# interval as a dedicated background service — the ONLY production reader.
BP_SYNC_INTERVAL_SECONDS=300   # how often to pull (seconds). 300 = every 5 min.
BP_SYNC_RUN_ON_START=1         # 1 = sync once on start, then every interval

# ---- LEGACY MySQL: only for migrate_mysql_to_pg.py (copying the old profiles) ----
# Not used by the running service. Remove once the migration is done.
TEST_MYSQL_HOST=your-mysql-host
TEST_MYSQL_PORT=18844
TEST_MYSQL_USER=your-mysql-user
TEST_MYSQL_PASSWORD=your-mysql-password
TEST_MYSQL_DB=defaultdb
TEST_MYSQL_CA=./ca.pem

# ---- scoring (POST /score) — the fast live decision endpoint ----
# Where to POST each decision. Empty = webhook off (decision still returned + audited).
BP_SCORE_WEBHOOK_URL=
BP_SCORE_WEBHOOK_TIMEOUT=5
# Optional: sign each webhook with HMAC-SHA256 (header X-Behaviour-Signature).
BP_SCORE_WEBHOOK_SECRET=
# 1 = run any retrain AFTER responding (fast, recommended). 0 = inline (debug).
BP_SCORE_RETRAIN_ASYNC=1
# ---- performance (fast /score) ----
BP_RULES_CACHE_TTL=30       # seconds to cache rules/blacklist/peer-baselines in process
BP_STORE_POOL_MIN=2         # profile-store connection pool (per process)
BP_STORE_POOL_MAX=10
BP_STORE_POOL_TIMEOUT=10

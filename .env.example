# Copy to `.env` and fill in. docker-compose and local runs load this automatically.

# ---- production Postgres (READ ONLY: the transactions source) ----
# Only sync_manager.py reads this. Point it at a READ REPLICA if one exists —
# that shields the primary completely (ingestionstratimprove.md §4).
PROD_PG_HOST=your-postgres-host
PROD_PG_PORT=25061
PROD_PG_USER=your-pg-user
PROD_PG_PASSWORD=your-pg-password
PROD_PG_DB=adhere
PROD_PG_SSLMODE=require

# ---- PROFILE STORE: PostgreSQL (where profiles / rules / cache / events live) ----
# In docker compose the host is the `db` service; STORE_PG_PASSWORD is required
# (compose refuses to start without it) and is the password on the database itself.
STORE_PG_HOST=db
STORE_PG_PORT=5432
# Port published on YOUR machine (5433 avoids clashing with a local postgres).
STORE_PG_HOST_PORT=5433
STORE_PG_USER=behaviour
STORE_PG_PASSWORD=change-me-strong-password
STORE_PG_DB=behaviour
STORE_PG_SSLMODE=prefer

# ---- learning / trust tuning (all optional; sensible defaults in config.py) ----
BP_LOOKBACK_MONTHS=3
BP_DECAY_HALF_LIFE=90
BP_MIN_TENURE_DAYS=90
# "Practical rules" §1: ">= 100 transactions" (§2 sanctions 50-500;
# 100 satisfies BOTH). Was 50, which met only §2.
BP_MIN_TXNS=100
BP_CONFIDENCE_TRUST=60
# §1: "No confirmed fraud cases" — max confirmed-fraud txns and still trusted. 0 = the PDF's rule.
BP_ELIGIBLE_MAX_FRAUD_TXNS=0
BP_RETRAIN_MIN_NEW_TXNS=100
BP_RETRAIN_MAX_AGE_DAYS=30
BP_DRIFT_SIGNAL_THRESHOLD=5

# ---- production protection ----
# Safety switch. 1 = allow live reads from prod (sync_manager + live velocity).
# 0 = STOP every live pull: the sync refuses to run, extracts refuse to run, and
# the service serves entirely from the local cache. Every pull / blocked attempt
# is logged to stdout.
BP_ALLOW_PROD_PULL=1

# ---- ingestion (sync_manager.py) — the dials the DB engineer can turn ----
# The sync is the ONLY process that reads production. It pages with a keyset
# cursor in bounded chunks, caps each run, and sleeps between chunks.
BP_SYNC_CHUNK_SIZE=5000            # rows per bounded query
BP_SYNC_MAX_ROWS=50000             # hard cap per run (0 = uncapped)
BP_SYNC_SLEEP_SECONDS=0.2          # throttle between chunks — raise to be gentler
BP_SYNC_STATEMENT_TIMEOUT_MS=30000 # server kills any runaway query
BP_SYNC_REFRESH_DAYS=2             # re-pull recent days so status flips are caught
BP_SYNC_PRUNE=1                    # drop cached rows older than the learning window
# --- scheduled ingestion (production): the sync runs automatically on this
# interval as a dedicated background service — the ONLY production reader.
BP_SYNC_INTERVAL_SECONDS=300   # how often to pull (seconds). 300 = every 5 min.
BP_SYNC_RUN_ON_START=1         # 1 = sync once on start, then every interval

# ---- BEHAVIOURAL MODEL (the ONE scoring engine behind /score) ----
# true = /score returns the ML model decision (production). The embedded model reads the store
# via BF_PG_* which fall back to STORE_PG_*, so no extra DB config is needed. Inference is CPU;
# the GPU is only used by the offline trainer.
BP_USE_MODEL=true
# §1 eligibility for TRAINING the model (target 100/90 as the data window grows past 90 days).
BF_MIN_TXNS=50
BF_MIN_DAYS_ACTIVE=30
# Velocity/bursts are MODEL features computed from each customer's recent history at score time:
# short windows vel_1m/vel_2m/vel_3m/vel_10m/vel_15m + vel_1h/vel_24h (all log1p-squashed). No
# separate rule engine / live_velocity table.
# Dynamic alert zones (recomputed by np.percentile on the validation dist each retrain — NOT
# hard-coded): review=p95 (grey zone), unsafe=p99 (Priority-1), strongest=p99.9.
BF_TIER_REVIEW=95
BF_TIER_UNSAFE=99
BF_TIER_HIGH=99.9
# Training uses the GPU if present, else CPU (automatic). Set BF_REQUIRE_GPU=1 for SCHEDULED
# GPU jobs so they fail-fast instead of silently CPU-training after a transient driver hiccup.
BF_REQUIRE_GPU=

# ---- scoring (POST /score) — the fast live decision endpoint ----
# Where to POST each decision. Empty = webhook off (decision still returned + audited).
BP_SCORE_WEBHOOK_URL=
BP_SCORE_WEBHOOK_TIMEOUT=5
# Optional: sign each webhook with HMAC-SHA256 (header X-Behaviour-Signature).
BP_SCORE_WEBHOOK_SECRET=
# 1 = run any retrain AFTER responding (fast, recommended). 0 = inline (debug).
BP_SCORE_RETRAIN_ASYNC=1

# ---- live-velocity feed (Redis) — real-time burst/velocity features ----
# /score records each transaction in Redis and reads recent ones back, so velocity/recency reflect
# activity not yet in the batch cache (real-time bursts). In docker compose this defaults to the
# `redis` service. Leave EMPTY to disable (velocity falls back to the cache). Fail-safe: if Redis is
# unreachable, scoring silently continues cache-only. TTL of the live window in hours below.
BP_REDIS_URL=redis://redis:6379/0
BP_VELOCITY_RETAIN_HOURS=48

# ---- API key auth for POST /score (header: X-Adhere-Key) ----
# Two ways to set the single active key:
#  (a) SIMPLE/FIXED — put the key here in BP_API_KEY (this value, hashed, is THE active key and
#      OVERRIDES the DB). config.py reads it and the container gets it via env_file/.env.
#  (b) ROTATING — leave BP_API_KEY empty and use `python manage_api_key.py rotate`: stored HASHED
#      in bp_api_key, exactly one active at a time, and rotating a new key invalidates the former.
# Standard HTTP semantics: missing OR wrong key -> 401 (+ WWW-Authenticate); body validation
# errors -> 422. A key is REQUIRED: if neither BP_API_KEY nor an active bp_api_key row exists (and
# auth is not disabled), the service FAILS TO START (clear error at startup) — it does not boot and
# then return 503. Generate the value with: openssl rand -hex 32
# BP_API_KEY_DISABLED=1 turns auth OFF (internal/dev only) and skips the startup key check.
BP_API_KEY=
BP_API_KEY_DISABLED=
BP_API_KEY_CACHE_TTL=30

# ---- alerting (Slack) — used by watchdog.sh, deploy.sh, and ml.monitor ----
# Set this to your Slack Incoming Webhook URL to get alerts (deploy result, container crash /
# unhealthy, profile-retrain failure, model health/drift). LEAVE EMPTY for now: everything still
# runs and is written to ./logs — alerts are just logged, not posted, until this is set.
BP_SLACK_WEBHOOK_URL=

# ---- production scheduling (the daily production data pull) ----
# PRODUCTION pulls fresh production data once a day at 04:00 — the `sync` service is the ONLY
# production reader. Keep BP_SYNC_AT_HOUR SET (uncommented) in production: when it is set the sync
# runs DAILY at that hour; when it is UNSET it falls back to INTERVAL mode (every
# BP_SYNC_INTERVAL_SECONDS above) — that is the initial-backfill mode, NOT the production schedule.
#
# DEVELOPMENT: to stop pulling production data in dev, either comment BP_SYNC_AT_HOUR out AND set
# BP_ALLOW_PROD_PULL=0 (the master switch — no live pulls at all; serve from the local cache), or
# leave it on interval only while backfilling. `deploy.sh` verifies this is set before a prod deploy.
#
# PREREQUISITE for ANY pull (dev or prod): this host's IP must be allowlisted on the production
# Postgres, or every pull fails to connect. `deploy.sh` confirms + directly verifies this first.
BP_SYNC_AT_HOUR=4
BP_SYNC_AT_MINUTE=0

# ---- deploy.sh: promote the LEARNT STATE to production (step 3) ----
# So production CONTINUES from the current learnt behaviour (profiles + peer baselines + the
# transaction cache + the sync watermark) and the daily 04:00 pull only adds the delta. Everything
# moves OUT-OF-BAND (never via git). PROD_STORE_DSN is the production behaviour store (target).
PROD_STORE_DSN=postgresql://behaviour:CHANGE_ME@PROD-STORE-HOST:5432/behaviour?sslmode=require
# Provide ONE learnt-state transport (deploy.sh auto-detects; the bundle wins if both exist):
#   (1) DIRECT DB->DB — set SRC_STORE_DSN to the store holding the learnt profiles + cache. Requires
#       the source reachable FROM the deploy host. deploy.sh pipes it live (pg_dump | psql).
#SRC_STORE_DSN=postgresql://behaviour:CHANGE_ME@YOUR-STORE-HOST:5432/behaviour
#   (2) STORE BUNDLE FILE — when the two DBs can't talk directly (e.g. you build it on your PC).
#       Build once:  ./prepare_release.sh   -> store-bundle.tar.gz + model-bundle.tar.gz (git-ignored;
#       they hold customer data — scp them securely). deploy.sh restores ./store-bundle.tar.gz
#       automatically, or point:
#STORE_BUNDLE=/path/to/store-bundle.tar.gz
# NO-FORGET automation (recommended for disconnected hosts): put the bundles in a PRIVATE object store
# and set these URLs. prepare_release.sh UPLOADS to them; deploy.sh FETCHES from them if the local file
# is missing — so nothing is scp'd by hand and nothing is committed to git. Schemes: s3:// gs:// file://
# (http(s):// is download-only). NEVER a public bucket — these hold customer data.
#STORE_BUNDLE_URL=s3://your-private-bucket/adhere/store-bundle.tar.gz
#MODEL_BUNDLE_URL=s3://your-private-bucket/adhere/model-bundle.tar.gz
# Optional model-artifact promotion target (rsync). Omit if artifacts/ is a shared volume; on a host
# that only has a git clone, ship the model bundle instead (MODEL_BUNDLE, default ./model-bundle.tar.gz).
#PROD_ARTIFACTS_DEST=user@prod-host:/opt/adhere/artifacts
#MODEL_BUNDLE=/path/to/model-bundle.tar.gz

# Plain-text audit log the container writes (bind-mounted to ./logs). Grep this after the fact.
BP_LOG_FILE=/app/logs/behaviour.log
# ---- performance (fast /score) ----
BP_RULES_CACHE_TTL=30       # seconds to cache rules/blacklist/peer-baselines in process
BP_STORE_POOL_MIN=2         # profile-store connection pool (per process)
BP_STORE_POOL_MAX=10
BP_STORE_POOL_TIMEOUT=10
